# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4000
LOG_LEVEL=INFO

# --- LLM ---
# provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_primary_model_id
LLM_MAX_OUTPUT_TOKENS=6000
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Fallback (optional). Leave provider/key empty to reuse the primary ones.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=your_fallback_model_id

# --- Website fetching ---
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
MAX_CONTENT_CHARS=12000
EXTRA_PAGES_MAX=2

# --- Cache ---
CACHE_TTL_SECONDS=3600

# --- API behaviour ---
RATE_LIMIT_PER_MINUTE=6
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_TIMEOUT_SECONDS=120
CACHE_MAX_ENTRIES=200
TRUST_PROXY=false

# --- CORS (comma separated; used in the connecting phase) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000